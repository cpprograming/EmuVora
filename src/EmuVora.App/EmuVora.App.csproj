<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault><Version>0.14.0</Version><ApplicationIcon>../../installer/EmuVora.ico</ApplicationIcon></PropertyGroup><ItemGroup><PackageReference Include="Svg.Skia" Version="3.0.2"/><PackageReference Include="Avalonia" Version="11.3.22"/><PackageReference Include="Avalonia.Desktop" Version="11.3.22"/><PackageReference Include="FluentAvaloniaUI" Version="2.5.1"/><ProjectReference Include="../EmuVora.Core/EmuVora.Core.csproj"/></ItemGroup><ItemGroup><AvaloniaResource Include="Assets/**"/><Content Include="../../installer/EmuVora.ico" Link="EmuVora.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup><PropertyGroup><ControllerRuntime>$(MSBuildProjectDirectory)/obj/controller-runtime</ControllerRuntime></PropertyGroup>
<Target Name="PrepareControllerRuntime" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' And '$(DesignTimeBuild)' != 'true'">
<Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/Prepare-Controllers.ps1&quot; -OutputDirectory &quot;$(ControllerRuntime)&quot;" />
</Target>
<ItemGroup>
<Content Include="$(ControllerRuntime)/SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
<Content Include="$(ControllerRuntime)/gamecontrollerdb.txt" Link="gamecontrollerdb.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
<Content Include="../../third-party/controller-licenses/*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
<Content Include="../../third-party/console-logos/UPSTREAM-README.txt" Link="ConsoleLogos.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
</ItemGroup></Project>




